classDiagram
    class Customer {
        <<entity>>
        -int customerId
        -String firstName
        -String lastName
        -String email
        -String phone
        -String username
        -String passwordHash
        -String address
        +updateProfile()
        +viewBookingHistory()
        +receivePromotion()
    }
    class Flight {
        <<entity>>
        -int flightId
        -String flightNumber
        -String origin
        -String destination
        -String airline
        -LocalDateTime departureTime
        -LocalDateTime arrivalTime
        -double price
        -int availableSeats
        +hasAvailableSeats()
        +getDuration()
        +matchesCriteria()
    }
    class SearchCriteria {
        <<entity>>
        -String origin
        -String destination
        -String airline
        -LocalDate departureDate
        -double maxPrice
        +matches()
        +isValid()
    }
    class LoginController {
        <<control>>
        -UserDAO userDAO
        +authenticate()
        +dashboardFor()
        +hasPermission()
    }
    class SearchController {
        <<control>>
        -FlightDAO flightDAO
        -SearchCriteria currentCriteria
        -List lastResults
        +searchFlights()
        +filterAvailableFlights()
        +selectFlight()
        +getFlightDetails()
        +sortResults()
    }
    class LoginView {
        <<boundary>>
        -LoginController loginController
        -JTextField usernameField
        -JPasswordField passwordField
        -JComboBox roleComboBox
        +displayRoleSelection()
        +submitCredentials()
        +displayLoginError()
    }
    class MainDashboardView {
        <<boundary>>
        -User currentUser
        -LoginController loginController
        +displayDashboard()
        +navigateToSearch()
        +navigateToBookingHistory()
        +logout()
    }
    class SearchView {
        <<boundary>>
        -SearchController controller
        -JTextField originField
        -JTextField destinationField
        -JSpinner dateSpinner
        -JComboBox airlineCombo
        +displaySearchForm()
        +validateInput()
        +submitSearch()
        +displayError()
    }
    class SearchResultsView {
        <<boundary>>
        -List flights
        -SearchController controller
        -JTable table
        +displayResults()
        +renderFlightRow()
        +handleFlightSelection()
        +showNoResultsMessage()
    }
    class FlightDetailsView {
        <<boundary>>
        -Flight selectedFlight
        -BookingController bookingController
        +displayFlightDetails()
        +navigateToBooking()
        +closeView()
    }